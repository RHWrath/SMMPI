<Application x:Class="SMMPI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="Theme_BackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="Theme_TextColor">#FF000000</Color>
        <SolidColorBrush x:Key="Theme_BackgroundBrush" Color="{DynamicResource Theme_BackgroundColor}" />
        <SolidColorBrush x:Key="Theme_TextBrush" Color="{DynamicResource Theme_TextColor}" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource Theme_BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Theme_TextBrush}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextBrush}" />
        </Style>
    </Application.Resources>
</Application>
