<UserControl x:Class="SMMPI.App.Views.MediaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:SMMPI.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ThumbTile" TargetType="ListBoxItem">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="128" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextBrush}" />
            <Setter Property="Background" Value="#FFF0F0F0" />
            <Setter Property="BorderBrush" Value="#FF6E6E6E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Transparent"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Media"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />
                <Border Grid.Row="1"
                        BorderBrush="#FF4A4A4A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Background="{DynamicResource Theme_BackgroundBrush}">
                    <ListBox ItemsSource="{Binding MediaItems}"
                             SelectedItem="{Binding SelectedMedia}"
                             ItemContainerStyle="{StaticResource ThumbTile}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:MediaItemViewModel}">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#FF2A2A2A" CornerRadius="6">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               Margin="0,6,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Mediavoorbeeld"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,10" />
                <Border Grid.Row="1"
                        BorderBrush="#FF4A4A4A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{DynamicResource Theme_BackgroundBrush}">
                    <Grid>
                        <Image Source="{Binding SelectedPreview}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   Text="Voorbeeld geselecteerd bestand">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreview}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Opacity="0.9" Text="{Binding SelectedFileName, StringFormat=Geselecteerd: {0}}" />
                        <TextBlock Margin="0,4,0,0" Opacity="0.85" Text="{Binding SelectedFileType, StringFormat=Type: {0}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Naar telefoon sturen"
                            Command="{Binding SendToDeviceCommand}"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
