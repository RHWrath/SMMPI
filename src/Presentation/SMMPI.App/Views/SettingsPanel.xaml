<UserControl x:Class="SMMPI.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Transparent"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Instellingen"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <StackPanel Grid.Row="1" Margin="0,20,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Medewerker" FontSize="14" Margin="0,0,0,6" />
                    <TextBox Height="32"
                             Margin="0,0,0,12"
                             VerticalContentAlignment="Center"
                             Text="{Binding OfficerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Zaaknummer" FontSize="14" Margin="0,0,0,6" />
                    <TextBox Height="32"
                             Margin="0,0,0,16"
                             VerticalContentAlignment="Center"
                             Text="{Binding CaseNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Media folder" FontSize="14" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Height="32"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding MediaLibraryFolder, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                Content="Bladeren..."
                                Command="{Binding BrowseMediaFolderCommand}"
                                MinWidth="96" />
                    </Grid>

                    <TextBlock Text="Zaakmap" FontSize="14" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Height="32"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding CaseLogFolder, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                Content="Bladeren..."
                                Command="{Binding BrowseCaseLogFolderCommand}"
                                MinWidth="96" />
                    </Grid>

                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Content="{Binding RecordButtonText}"
                                Click="ToggleRecording_Click"
                                MinWidth="120" />
                        <Button Margin="10,0,0,0"
                                Content="Sessie exporteren"
                                Command="{Binding ExportSessionCommand}"
                                MinWidth="120" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <StackPanel>
                <TextBlock FontSize="18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Text="Telefoonstatus" />
                <TextBlock Margin="0,12,0,0" Text="{Binding ConnectionStatus, StringFormat=Verbinding: {0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding DeviceName, StringFormat=Telefoon: {0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ActiveApp, StringFormat=Actieve app: {0}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
