    <ApplicationDefinition Remove="src\layers\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\SMMPI.Application\SMMPI.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\SMMPI.Infrastructure.Adb\SMMPI.Infrastructure.Adb.csproj" />
    <ProjectReference Include="..\..\Infrastructure\SMMPI.Infrastructure.Logging\SMMPI.Infrastructure.Logging.csproj" />
    <ProjectReference Include="..\..\Infrastructure\SMMPI.Infrastructure.Plugins\SMMPI.Infrastructure.Plugins.csproj" />
    <ProjectReference Include="..\..\Infrastructure\SMMPI.Infrastructure.Reporting\SMMPI.Infrastructure.Reporting.csproj" />
  </ItemGroup>
