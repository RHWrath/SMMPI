<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\layers\**\*.cs" />
    <EmbeddedResource Remove="src\layers\**\*" />
    <None Remove="src\layers\**\*" />
    <Page Remove="src\layers\**\*.xaml" />
    <ApplicationDefinition Remove="src\layers\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\packages\Discord\WpfApp1\Discord.csproj" />
    <ProjectReference Include="..\..\Core\SMMPI.Application\SMMPI.Application.csproj" />
    <ProjectReference Include="..\..\Core\SMMPI.Domain\SMMPI.Domain.csproj" />
    <ProjectReference Include="..\..\Infrastructure\SMMPI.Infrastructure.Adb\SMMPI.Infrastructure.Adb.csproj" />
    <ProjectReference Include="..\..\Infrastructure\SMMPI.Infrastructure.Logging\SMMPI.Infrastructure.Logging.csproj" />
  </ItemGroup>

</Project>
