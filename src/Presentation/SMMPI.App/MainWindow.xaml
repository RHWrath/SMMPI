<Window x:Class="SMMPI.App.MainWindow"        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:SMMPI.App.ViewModels"
        mc:Ignorable="d"
        Title="SMMPI Operator"
        Width="1600"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        Foreground="{DynamicResource Theme_TextBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FFB0B0B0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ThumbTile" TargetType="ListBoxItem">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="128" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme_TextBrush}" />
            <Setter Property="Background" Value="#FFF0F0F0" />
            <Setter Property="BorderBrush" Value="#FF6E6E6E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.65*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.75*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Instellingen"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <StackPanel Grid.Row="1" Margin="0,20,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding OfficerName, StringFormat=Medewerker: {0}}" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CaseNumber, StringFormat=Zaak: {0}}" FontSize="13" Margin="0,0,0,16" />
                        <TextBlock Text="Media folder" FontSize="14" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Height="32"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Text="{Binding MediaLibraryFolder, Mode=OneWay}" />
                            <Button Grid.Column="1"
                                    Content="Bladeren..."
                                    Command="{Binding BrowseMediaFolderCommand}"
                                    MinWidth="96" />
                        </Grid>

                        <TextBlock Text="Zaakmap" FontSize="14" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Height="32"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Text="{Binding CaseLogFolder, Mode=OneWay}" />
                            <Button Grid.Column="1"
                                    Content="Bladeren..."
                                    Command="{Binding BrowseCaseLogFolderCommand}"
                                    MinWidth="96" />
                        </Grid>

                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Content="{Binding RecordButtonText}"
                                    Click="ToggleRecording_Click"
                                    MinWidth="120" />
                            <Button Margin="10,0,0,0"
                                    Content="Sessie exporteren"
                                    Command="{Binding ExportSessionCommand}"
                                    MinWidth="120" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Media"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,12" />
                    <Border Grid.Row="1"
                            BorderBrush="#FF4A4A4A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Background="{DynamicResource Theme_BackgroundBrush}">
                        <ListBox ItemsSource="{Binding MediaItems}"
                                 SelectedItem="{Binding SelectedMedia}"
                                 ItemContainerStyle="{StaticResource ThumbTile}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MediaItemViewModel}">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#FF2A2A2A" CornerRadius="6">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="11"
                                                   Margin="0,6,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2"
                Background="Transparent"
                BorderBrush="#FFB0B0B0"
                BorderThickness="2"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="22" Text="Telefoonstream" />
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.75"
                                   Text="{Binding StatusMessage}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Opacity="0.62"
                                   TextWrapping="Wrap"
                                   Text="Klik op de preview zodra een telefoon verbonden is. Toetsen worden naar de telefoon gestuurd. Ctrl+V plakt het klembord." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Stream verversen"
                                Command="{Binding RefreshDeviceCommand}"
                                MinWidth="120" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="#FF4A4A4A"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinHeight="320"
                        Background="{DynamicResource Theme_BackgroundBrush}">
                    <Grid>
                        <Image x:Name="StreamImage"
                               Source="{Binding StreamImage}"
                               Stretch="Uniform"
                               Focusable="True"
                               IsEnabled="{Binding CanSendDeviceKeyboard}"
                               KeyboardNavigation.TabNavigation="Once"
                               PreviewKeyDown="StreamImage_PreviewKeyDown"
                               PreviewTextInput="StreamImage_PreviewTextInput"
                               MouseLeftButtonDown="StreamImage_MouseLeftButtonDown"
                               MouseMove="StreamImage_MouseMove"
                               MouseLeftButtonUp="StreamImage_MouseLeftButtonUp" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Opacity="0.55"
                                   Text="Wachten op telefoonstream">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StreamImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="20*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="60*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="20*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Text="Telefoonstatus" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding ConnectionStatus, StringFormat=Verbinding: {0}}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding DeviceName, StringFormat=Telefoon: {0}}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ActiveApp, StringFormat=Actieve app: {0}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Mediavoorbeeld"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,10" />
                    <Border Grid.Row="1"
                            BorderBrush="#FF4A4A4A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource Theme_BackgroundBrush}">
                        <Grid>
                            <Image Source="{Binding SelectedPreview}" Stretch="Uniform" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.6"
                                       Text="Voorbeeld geselecteerd bestand">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPreview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Selectie"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Vertical">
                            <TextBlock Opacity="0.9" Text="{Binding SelectedFileName, StringFormat=Geselecteerd: {0}}" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.85" Text="{Binding SelectedFileType, StringFormat=Type: {0}}" />
                        </StackPanel>
                        <Button Grid.Row="1"
                                Content="Naar telefoon sturen"
                                Command="{Binding SendToDeviceCommand}"
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,12,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
