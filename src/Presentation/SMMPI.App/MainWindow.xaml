<Window x:Class="SMMPI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:SMMPI.App.ViewModels"
        xmlns:views="clr-namespace:SMMPI.App.Views"
        mc:Ignorable="d"
        Title="SMMPI Operator"
        Width="1600"
        Height="900"
        MinWidth="1400"
        MinHeight="720"
        Foreground="{DynamicResource Theme_TextBrush}"
        Cursor="{Binding AppCursor}"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.75*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.825*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.575*" />
        </Grid.ColumnDefinitions>

        <views:SettingsPanel Grid.Column="0"
                             ToggleRecordingRequested="SettingsPanel_ToggleRecordingRequested" />
        <views:PhoneStreamPanel x:Name="PhoneStreamPanel" Grid.Column="2" />
        <views:MediaPanel Grid.Column="4" />
    </Grid>
</Window>
