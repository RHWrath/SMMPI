<Window x:Class="WPFTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox x:Name="ComboBox1" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Top" Width="120"/>
            <Button x:Name="Init" Content="Button" HorizontalAlignment="Center" VerticalAlignment="Center" Click="InitApplication"/>
        </StackPanel>
    </Grid>
</Window>
