class ParserJSONtoPDF
{
    //Methode om de JSON bestanden te importeren, waarbij de inhoud van elk bestand wordt gelezen en weergegeven in de console. Deze methode kan later worden uitgebreid om de JSON data te parseren en te gebruiken voor PDF generatie.
    public async Task ImportJSONFiles()
    {
        string inputDirectory = "INPUTJSON";
        string[] jsonFiles = Directory.GetFiles(inputDirectory, "*.json");

// Lees de inhoud van elk JSON bestand
        foreach (string jsonFile in jsonFiles)
        {
            string jsonContent = File.ReadAllText(jsonFile);
            Console.WriteLine("Inhoud van " + jsonFile + ": " + jsonContent);
            // Controle of de JSON inhoud uitgelezen kan worden binnen de Terminal.
        }
        
    }
}
